{
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "importOrder": ["<THIRD_PARTY_MODULES>", "^@pingpong-io/(.*)$", "^[./]"],
    "importOrderSortSpecifiers": true,
    "importOrderSeparation": true
}
