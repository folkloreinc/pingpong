{
    "name": "@pingpong-io/client",
    "version": "0.2.1",
    "description": "JavaScript client for Pingpong, for browsers and Node",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/pingpong.git",
        "directory": "packages/client"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@pingpong-io/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@pingpong-io/protocol": "^0.2.1",
        "socket.io-client": "^4.8.4"
    },
    "devDependencies": {
        "@pingpong-io/server": "0.2.1"
    }
}
