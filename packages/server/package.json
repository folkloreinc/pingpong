{
    "name": "@pingpong-io/server",
    "version": "0.2.0",
    "description": "The Pingpong server: projects, channels, HTTP API and the pingpong CLI, on Socket.IO",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/pingpong.git",
        "directory": "packages/server"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@pingpong-io/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./testing": {
            "@pingpong-io/source": "./src/testing.ts",
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "pingpong": "./dist/cli/main.js"
    },
    "dependencies": {
        "@pingpong-io/dashboard": "^0.2.0",
        "@pingpong-io/protocol": "^0.2.0",
        "@socket.io/redis-streams-adapter": "^0.3.1",
        "fastify": "^5.12.7",
        "kysely": "^0.29.6",
        "pg": "^8.23.1",
        "redis": "^6.3.1",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1"
    }
}
