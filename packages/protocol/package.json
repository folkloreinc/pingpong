{
    "name": "@pingpong-io/protocol",
    "version": "0.2.0",
    "description": "The Pingpong protocol: messages, HTTP API and their schemas",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/pingpong.git",
        "directory": "packages/protocol"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@pingpong-io/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./events": {
            "@pingpong-io/source": "./src/events.ts",
            "types": "./dist/events.d.ts",
            "default": "./dist/events.js"
        },
        "./signatures": {
            "@pingpong-io/source": "./src/signatures.ts",
            "types": "./dist/signatures.d.ts",
            "default": "./dist/signatures.js"
        },
        "./openapi.json": "./schema/openapi.json",
        "./pingpong.schema.json": "./schema/pingpong.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "schema"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "generate": "node scripts/generate.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1"
    },
    "devDependencies": {
        "@readme/openapi-parser": "^9.1.0",
        "openapi-typescript": "^7.13.0"
    }
}
